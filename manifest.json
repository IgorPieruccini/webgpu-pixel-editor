{
  "$schema": "https://api.kittl.com/extensions/manifest/schema.json",
  "displayName": "Kixel Editor",
  "icon": "icon.svg",
  "tagline": "Kixel Editor for Kittl.",
  "installPage": {
    "description": "Install Kixel Editor to use this extension in Kittl.",
    "coverImage": "icon.svg",
    "termsAndConditionsLink": "https://example.com/terms",
    "privacyPolicyLink": "https://example.com/privacy"
  },
  "config": {
    "scopes": [
      "design:state:read",
      "design:state:write"
    ],
    "embed": {
      "mainAppPanel": {
        "path": "index.html"
      }
    }
  }
}
