#tool-settings {
  position: relative;
  z-index: 10;
  gap: 12px;
  min-height: 52px;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  background: var(--surface);
  border-radius: 16px;
  border: 1px solid var(--surface-border);
  box-shadow: var(--shadow-md);
  backdrop-filter: blur(18px);
  padding: 0px 12px 0px 12px;
}

#menu-section {
  width: 240px;
}

#general-section {
  display: flex;
  justify-content: end;
}
